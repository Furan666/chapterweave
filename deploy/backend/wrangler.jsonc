{
  "name": "chapterweave-private-backend",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "QLOO_BUDGET", "class_name": "QlooBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["QlooBudget"] }
  ],
  "ratelimits": [
    {
      "name": "PER_IP_LIMIT",
      "namespace_id": "3105401",
      "simple": { "limit": 15, "period": 60 }
    },
    {
      "name": "SITE_LIMIT",
      "namespace_id": "3105402",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
